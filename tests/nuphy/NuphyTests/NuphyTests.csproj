<Project Sdk="Microsoft.NET.Sdk">

  <!-- Firmware tests on an emulated board. Run: dotnet run (project dir tests/nuphy/NuphyTests)
       Needs Docker and the built firmware (.build/nuphy_air96_v2_ansi_default.elf, or NUPHY_ELF). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
